# .env.example — variáveis de ambiente usadas pela suíte de testes do GLPI Chat.
#
# Este plugin NÃO le arquivo .env em produção — GLPI não usa esse mecanismo de
# configuração. Estas variáveis são consumidas apenas pelos scripts sob
# `tests/` (integração, smoke, E2E) para localizar a instância GLPI de teste,
# apontar para o ticket dedicado da esteira e habilitar opt-ins destrutivos.
#
# Copie para `.env` e ajuste os valores, ou exporte diretamente no shell/CI
# antes de rodar `tests/run_full_suite.sh` / `tests/run_unit_php.sh`.

# URL base da instância GLPI usada pelos testes de integração, smoke HTTP e
# E2E (Python/Playwright). Aponta para o host:porta onde o GLPI de teste está
# servido (ex.: container docker local).
GLPICHAT_BASE_URL=http://localhost:8080

# Caminho de instalação do GLPI dentro do container/host onde os testes
# rodam. Usado pelos runners de smoke/integração para montar o caminho do
# plugin dentro do container (ex.: docker exec).
GLPI_INSTALL_DIR=/var/www/glpi

# ID do chamado (ticket) dedicado à esteira de testes. Normalmente é
# resolvido automaticamente por `tests/e2e/setup/prepare_env.php` e exportado
# para os demais passos por `tests/run_full_suite.sh` — defina manualmente
# apenas se for rodar uma suíte isolada contra um ticket já existente.
GLPICHAT_TICKET_ID=1

# ID de um segundo chamado, usado pelos testes E2E que validam isolamento
# entre salas/chamados distintos (ex.: garantir que mensagens de um ticket
# não vazam para outro).
GLPICHAT_OTHER_TICKET_ID=2

# ID do usuário "self" (solicitante/requester) associado ao ticket dedicado
# da esteira. Resolvido automaticamente por prepare_env.php; normalmente não
# precisa ser definido manualmente.
GLPICHAT_SELF_ID=0

# ID do usuário "glpi" (técnico/assign) associado ao ticket dedicado da
# esteira. Usado como fallback determinístico em alguns smoke tests quando
# nenhum outro ator está disponível.
GLPICHAT_GLPI_ID=0

# Opt-in explícito para habilitar o teste destrutivo de install/uninstall
# (tests/lifecycle/install_uninstall_test.php), que executa DROP TABLE nas
# tabelas do plugin. Defina como "1" APENAS contra um banco de dados
# descartável — NUNCA em um ambiente com dados reais. Qualquer outro valor
# (ou ausência da variável) faz o teste ser pulado.
GLPICHAT_ALLOW_DESTRUCTIVE_TEST=0
